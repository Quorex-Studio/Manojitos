# Copia este archivo a .env (o corre `npm run nueva-tienda`) y en Vercel
# carga las mismas variables en Settings → Environment Variables.

# ── Supabase (Project Settings → API) ──
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_VAPID_PUBLIC_KEY=""

# ── Marca de la tienda ──
VITE_BRAND_NAME="Manojitos"
VITE_BRAND_DOMAIN="manojitos.vercel.app"
VITE_BRAND_TAGLINE="Tu tienda de confianza con los mejores productos."
VITE_BRAND_CONTACT_EMAIL="contacto@manojitos.com"
VITE_BRAND_SUPPORT_EMAIL="soporte@manojitos.com"
VITE_BRAND_INSTAGRAM="manojitos.shop"
VITE_BRAND_STORAGE_KEY="manojitos"
VITE_BRAND_THEME_COLOR="#D4AF37"
VITE_BRAND_BACKGROUND_COLOR="#faf8f5"
VITE_ASSISTANT_NAME="Ángela"
VITE_BRAND_WHATSAPP=""            # +58 412 0000000 (vacío = se oculta)
VITE_BRAND_HOURS="Lunes a Viernes: 8:00 AM - 6:00 PM · Sábados: 9:00 AM - 1:00 PM"
VITE_BRAND_LOCATION="Venezuela"

# ── Analítica (vacío = desactivado) ──
VITE_GTM_ID=""
