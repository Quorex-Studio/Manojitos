# Copia este archivo a .env (o corre `npm run nueva-tienda`) y en Vercel
# carga las mismas variables en Settings → Environment Variables.

# ── Supabase (Project Settings → API) ──
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_VAPID_PUBLIC_KEY=""

# ── Marca de la tienda ──
VITE_BRAND_NAME="EINA"
VITE_BRAND_DOMAIN="einashopv.com"
VITE_BRAND_TAGLINE="Tu tienda de confianza con los mejores productos."
VITE_BRAND_CONTACT_EMAIL="contacto@einashopv.com"
VITE_BRAND_SUPPORT_EMAIL="soporte@einashopv.com"
VITE_BRAND_INSTAGRAM="einashopv"
VITE_BRAND_STORAGE_KEY="eina"
VITE_BRAND_THEME_COLOR="#D4AF37"
VITE_BRAND_BACKGROUND_COLOR="#faf8f5"
VITE_ASSISTANT_NAME="Ángela"

# ── Analítica (vacío = desactivado) ──
VITE_GTM_ID=""
